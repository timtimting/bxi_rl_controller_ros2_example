+  void RobotHwMessageHandler::communication_watchdog()
+  {
+    char host[256] = {};
+    gethostname(host, sizeof(host) - 1);
+    const char *domain = std::getenv("ROS_DOMAIN_ID");
+    RCLCPP_INFO(this->get_logger(),
+      "communication_trace {\"event\":\"started\",\"side\":\"hardware\",\"pid\":%d,"
+      "\"host\":\"%s\",\"rmw\":\"%s\",\"domain\":\"%s\",\"threshold_ms\":200,"
+      "\"command_qos\":\"best_effort/volatile/keep_last/1\"}",
+      getpid(), host, rmw_get_implementation_identifier(), domain ? domain : "0");
+    auto &trace = communication_trace_;
+    bool was_stalled = false, pending = false;
+    int64_t previous = CommunicationTrace::mono_ns();
+    int64_t previous_wall = CommunicationTrace::wall_ns();
+    int64_t last_report = 0, max_watchdog_gap = 0, clock_jump = 0;
+    int64_t reported_command_gap = 0, reported_joint_gap = 0;
+    while (running_)
+    {
+      std::this_thread::sleep_for(50ms);
+      if (!running_) break;
+      const auto now = CommunicationTrace::mono_ns();
+      const auto wall = CommunicationTrace::wall_ns();
+      const auto elapsed = now - previous;
+      const auto delta = wall - previous_wall - elapsed;
+      previous = now;
+      previous_wall = wall;
+      if (elapsed > 200000000LL) { max_watchdog_gap = std::max(max_watchdog_gap, elapsed); pending = true; }
+      if (std::abs(delta) > 100000000LL) { clock_jump = delta; pending = true; }
+      pending = trace.incident.exchange(false) || pending;
+      const auto command_gap = trace.command_rx.max_gap.load();
+      const auto joint_gap = trace.joint_tx.max_gap.load();
+      if ((command_gap > 200000000LL && command_gap > reported_command_gap) ||
+          (joint_gap > 200000000LL && joint_gap > reported_joint_gap)) pending = true;
+      const auto joint_started = trace.joint.since.load();
+      const bool joint_busy = joint_started && now - joint_started > 200000000LL &&
+          std::strcmp(trace.joint.phase.load(), "waiting_executor") != 0;
+      const bool stalled = joint_busy || trace.command_rx.age_ms(now) > 200 ||
+          trace.joint_tx.age_ms(now) > 200 || trace.motor_tx.age_ms(now) > 200;
+      if ((!stalled && !was_stalled && !pending) || now - last_report < 1000000000LL) continue;
+      const auto text = trace.json(now, this->now().nanoseconds(), step_.load());
+      RCLCPP_WARN(this->get_logger(),
+        "communication_trace {\"event\":\"%s\",\"side\":\"hardware\",\"pid\":%d,\"host\":\"%s\","
+        "\"command_matched_publishers\":%zu,\"feedback_matched_subscriptions\":%zu,"
+        "\"watchdog_gap_ms\":%.3f,\"wall_clock_jump_ms\":%.3f,%s}",
+        stalled ? "stall" : (was_stalled ? "recovered" : "incident"), getpid(), host,
+        actuator_cmd_subscription_->get_publisher_count(), actuator_states_publisher_->get_subscription_count(),
+        max_watchdog_gap / 1e6, clock_jump / 1e6, text.c_str());
+      last_report = now;
+      was_stalled = stalled;
+      pending = false;
+      max_watchdog_gap = clock_jump = 0;
+      reported_command_gap = command_gap;
+      reported_joint_gap = joint_gap;
+    }
+  }
