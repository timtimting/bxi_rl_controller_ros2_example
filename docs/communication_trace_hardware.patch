diff --git a/src/hardware_elf3/include/hardware/communication_trace.hpp b/src/hardware_elf3/include/hardware/communication_trace.hpp
new file mode 100644
--- /dev/null
+++ b/src/hardware_elf3/include/hardware/communication_trace.hpp
@@ -0,0 +1,115 @@
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <sstream>
+
+// Observation only. No ROS/control locks, allocation or logging in hot paths.
+namespace robothw {
+struct CommunicationTrace {
+  static int64_t mono_ns() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+  }
+  static int64_t wall_ns() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+  }
+  static void maximum(std::atomic<int64_t> &target, int64_t value) {
+    auto old = target.load(std::memory_order_relaxed);
+    while (old < value && !target.compare_exchange_weak(old, value, std::memory_order_relaxed)) {}
+  }
+  struct Stream {
+    std::atomic<int64_t> last{0}, stamp{0}, max_gap{0};
+    std::atomic<uint64_t> count{0};
+    void record(int64_t source_stamp = 0) {
+      const auto now = mono_ns();
+      const auto previous = last.exchange(now, std::memory_order_relaxed);
+      stamp.store(source_stamp, std::memory_order_relaxed);
+      count.fetch_add(1, std::memory_order_relaxed);
+      if (previous) maximum(max_gap, now - previous);
+    }
+    double age_ms(int64_t now) const {
+      const auto value = last.load(std::memory_order_relaxed);
+      return value ? (now - value) / 1e6 : -1.0;
+    }
+    void json(std::ostream &out, int64_t now) const {
+      out << "{\"count\":" << count.load() << ",\"age_ms\":" << age_ms(now)
+          << ",\"stamp_ns\":" << stamp.load() << ",\"max_gap_ms\":" << max_gap.load() / 1e6 << "}";
+    }
+  };
+  struct Lane {
+    std::atomic<const char *> phase{"waiting_executor"};
+    std::atomic<int64_t> since{0};
+    void enter(const char *value) {
+      since.store(mono_ns(), std::memory_order_relaxed);
+      phase.store(value, std::memory_order_release);
+    }
+    void json(std::ostream &out, int64_t now) const {
+      const auto started = since.load();
+      out << "{\"stage\":\"" << phase.load(std::memory_order_acquire)
+          << "\",\"age_ms\":" << (started ? (now - started) / 1e6 : -1.0) << "}";
+    }
+    struct Guard {
+      Lane &lane;
+      explicit Guard(Lane &value) : lane(value) {}
+      ~Guard() { lane.enter("waiting_executor"); }
+    };
+  };
+
+  Stream command_rx, command_applied, joint_tx, motor_tx;
+  Lane joint, command;
+  std::atomic<int64_t> dds_source{0}, dds_received{0}, callback_wall{0};
+  std::atomic<int64_t> max_dds_wait{0}, max_transport{0};
+  std::atomic<int64_t> motor_wait_result{0};
+  std::atomic<uint64_t> motor_timeouts{0}, rejected_commands{0}, watchdog_drops{0};
+  std::atomic<bool> incident{false};
+
+  void received(int64_t stamp_ns, int64_t source_ns, int64_t received_ns) {
+    const auto now = wall_ns();
+    command_rx.record(stamp_ns);
+    dds_source.store(source_ns);
+    dds_received.store(received_ns);
+    callback_wall.store(now);
+    if (received_ns > 0) {
+      maximum(max_dds_wait, now - received_ns);
+      if (now - received_ns > 200000000LL || now - received_ns < -200000000LL) incident = true;
+      if (source_ns > 0) {
+        maximum(max_transport, received_ns - source_ns);
+        if (received_ns - source_ns > 200000000LL || received_ns - source_ns < -200000000LL) incident = true;
+      }
+    }
+  }
+
+  std::string json(int64_t now, int64_t ros_now, int step) const {
+    std::ostringstream out;
+    out << "\"mono_ns\":" << now << ",\"wall_ns\":" << wall_ns()
+        << ",\"ros_now_ns\":" << ros_now << ",\"step\":" << step
+        << ",\"command_rx\":"; command_rx.json(out, now);
+    out << ",\"command_applied\":"; command_applied.json(out, now);
+    out << ",\"joint_tx\":"; joint_tx.json(out, now);
+    out << ",\"motor_tx\":"; motor_tx.json(out, now);
+    out << ",\"joint_lane\":"; joint.json(out, now);
+    out << ",\"command_lane\":"; command.json(out, now);
+    out << ",\"command_source_age_ms\":";
+    if (command_rx.stamp.load()) out << (ros_now - command_rx.stamp.load()) / 1e6;
+    else out << "null";
+    out << ",\"dds_source_ns\":" << dds_source.load()
+        << ",\"dds_received_ns\":" << dds_received.load()
+        << ",\"dds_to_callback_ms\":";
+    if (dds_received.load() > 0) out << (callback_wall.load() - dds_received.load()) / 1e6;
+    else out << "null";
+    out << ",\"source_to_dds_ms\":";
+    if (dds_received.load() > 0 && dds_source.load() > 0) out << (dds_received.load() - dds_source.load()) / 1e6;
+    else out << "null";
+    out << ",\"max_dds_to_callback_ms\":" << max_dds_wait.load() / 1e6
+        << ",\"max_source_to_dds_ms\":" << max_transport.load() / 1e6
+        << ",\"motor_wait_result\":" << motor_wait_result.load()
+        << ",\"motor_timeouts\":" << motor_timeouts.load()
+        << ",\"rejected_commands\":" << rejected_commands.load()
+        << ",\"watchdog_drops\":" << watchdog_drops.load();
+    return out.str();
+  }
+};
+}  // namespace robothw
